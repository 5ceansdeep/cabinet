// 서류함의 기록 — 사용자와, 그가 서랍에 넣어 둔 곡들.
// DB 는 원격 Postgres(Neon) — 여러 PC 에서 같은 곡·서랍을 본다. 주소는 .env 의 DATABASE_URL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String    @id @default(cuid())
  email      String    @unique
  nickname   String
  password   String // bcrypt 해시
  resetHash  String?   @unique // 비밀번호 재설정 링크 토큰의 sha256 — 토큰 원문은 메일에만
  resetUntil DateTime? // 이때까지만 유효(30분)
  createdAt  DateTime  @default(now())
  shelves    Shelf[]
}

/// 서랍 하나 = 저장한 플레이리스트. 네임택(tag)과 그때의 요청문을 같이 남긴다
model Shelf {
  id        String       @id @default(cuid())
  tag       String
  query     String       @default("")
  createdAt DateTime     @default(now())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  tracks    ShelfTrack[]

  @@index([userId, createdAt])
}

/// 곡 — iTunes(커버·미리듣기)와 유튜브(영상) 정보를 한 번 모아 두고 재사용한다
model Track {
  id           String       @id @default(cuid())
  title        String
  artist       String
  artwork      String? // iTunes 앨범 커버 URL
  previewUrl   String? // iTunes 30초 미리듣기
  videoId      String? // 유튜브 영상 ID — 재생목록에 담을 때 쓴다
  checkedAt    DateTime? // 영상 ID 를 마지막으로 찾아본 때 — 못 찾았으면 30일 동안 다시 안 묻는다
  tags         String       @default("{}") // Last.fm 태그 가중치 JSON {"indie": 100, "dreamy": 42} — SQLite 시절 그대로 문자열 (코드가 JSON.parse 한다)
  // 소리 숫자 — ReccoBeats 가 30초 미리듣기를 분석한 값(0~1, tempo 는 BPM). 분위기 점수에 쓴다 (docs/recommend-plan.md)
  energy       Float?
  valence      Float?
  danceability Float?
  acousticness Float?
  tempo        Float?
  soundAt      DateTime? // 분석해 본 때 — 분석이 안 되는 파일이면 숫자 없이 이것만 찍혀 다시 안 올린다
  // 뜻 — Gemini 가 가사·제목·소리로 쓴 곡 설명(감정/상황/가사/소리)과 그 임베딩. 가사 원문은 저장하지 않는다
  description  String?
  embedding    String? // JSON 숫자 배열(catalog/gemini.ts DIM 차원, 길이 1)
  hasLyrics    Boolean? // 가사를 보고 썼나 — 없으면 제목·가수만으로 써서 뜻이 약하다
  instrumental Boolean? // LRCLIB 기록 — true 연주곡, false 노래, null 못 찾음(연주곡인지 모른다)
  describedAt  DateTime?
  shelves      ShelfTrack[]
  throws       ThrowLog[]

  @@unique([title, artist])
}

/// 서랍에 꽂힌 순서
model ShelfTrack {
  shelfId String
  trackId String
  order   Int
  shelf   Shelf  @relation(fields: [shelfId], references: [id], onDelete: Cascade)
  track   Track  @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@id([shelfId, trackId])
}

/// 검색 기록 — 요청 해석 태그와 결과 상위 가수. 곡 풀 넓히기(관리자 배치)가 사람들이 찾는 쪽으로 곡을 모을 때 씨앗으로 쓴다.
/// 10/2 부터 편지 글(query)과 화면에 나온 곡(tracks)도 남긴다 — 어떤 편지에 어떤 곡이 나왔나(베타 안내문에 고지). 사용자·IP 는 남기지 않는다
model SearchLog {
  id        String   @id @default(cuid())
  tags      String // {"night": 100, ...}
  artists   String   @default("[]") // ["검정치마", ...]
  query     String   @default("") // 편지 글 — 10/2 사용자: 어떤 편지에 어떤 곡이 나왔나 보려고(베타 안내문에 고지). 사용자·IP 는 안 남긴다
  tracks    String   @default("[]") // 화면에 나온 순서대로 ["가수 - 제목", ...]
  line      String   @default("") // 그때 신의 한마디(자막) — 재정렬이 늦거나 실패하면 빈 칸
  asked     String   @default("[]") // 편지에 직접 쓴 가수(해석 artists) — 곡 풀 넓히기가 그 가수 인기곡을 먼저 모은다(10/2 박효신)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// 던진 곡 기록 — 여러 사람이 자꾸 던지는 곡은 순위를 조금 내리고(recommend/score.ts), 곡 풀 넓히기 씨앗 가수에서 뺀다.
/// 요청문 원문과 사용자는 남기지 않는다
model ThrowLog {
  id        String   @id @default(cuid())
  trackId   String
  track     Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// 행동 기록 — 재생·끝까지 들음(곡), 서랍에 저장·공유·유튜브로 이동(서랍). 무엇이 실제로 들리고 담기는지 = 진짜 평가 세트 재료.
/// 재생·끝까지 들음엔 그 곡을 꺼낸 요청문을 같이 남긴다(어떤 편지 → 어떤 곡). 사용자·IP 는 남기지 않는다. 모르는 id 도 그대로 — 가짜 곡·브라우저 서랍이면 그냥 안 맞는다
model EventLog {
  id        String   @id @default(cuid())
  type      String // play | finish | save | share | youtube
  trackId   String?
  shelfId   String?
  query     String? // 요청문 — play·finish
  createdAt DateTime @default(now())

  @@index([createdAt])
}
