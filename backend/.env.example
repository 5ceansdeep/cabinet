# Neon(Postgres) 대시보드 Connect → Connection pooling 끄고 복사한 direct 주소 (호스트에 -pooler 없는 것 — 마이그레이션이 풀링 주소에서 막힌다)
DATABASE_URL="postgresql://neondb_owner:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require"
# 필수 — 없으면 서버가 안 켜진다. 만들기: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# 배포 서버에는 따로 하나 더 만들어 넣는다 — 로컬 키와 같은 값을 쓰지 않는다. 바꾸면 기존 로그인 토큰은 전부 무효
JWT_SECRET="change-me"
ADMIN_EMAILS="" # 곡 수집(POST /catalog/collect)을 부를 수 있는 이메일, 쉼표로 구분
PORT=4000
LASTFM_API_KEY=""
LASTFM_SHARED_SECRET=""
YOUTUBE_API_KEY=""
YT_SEARCH_DAILY_LIMIT="60"
# 신의 한마디 영어 음성(ElevenLabs) — 크레딧을 아끼려고 평소엔 false. true 면 아래 둘이 없을 때 서버가 안 켜진다
# 키: elevenlabs.io → Developers → API Keys (Text to Speech 권한만, 월 크레딧 한도 걸기). 목소리: Voices → Copy Voice ID
ELEVENLABS_ENABLED="false"
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID=""
# 필수 — 없으면 서버가 안 켜진다. aistudio.google.com → Get API key (무료 한도: Flash 계열만, Pro 는 0)
GEMINI_API_KEY=""
